{
  "name": "legiit-lens",
  "version": "0.1.0",
  "private": true,
  "description": "Shows how visible a web page or brand is in Google results and AI answers, and what explains it.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "npm run model:verify && npm run notices && wxt zip && node scripts/package-release.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && playwright test",
    "e2e:only": "playwright test",
    "screenshots": "npm run build && playwright test --config playwright.store.config.ts",
    "mock": "node mock-server/server.mjs",
    "model:fetch": "node scripts/fetch-model.mjs",
    "model:verify": "node scripts/fetch-model.mjs --verify-only",
    "icons": "node scripts/make-icons.mjs",
    "notices": "node scripts/make-notices.mjs",
    "privacy:html": "node scripts/render-privacy-policy.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "api:check": "node scripts/api-check.mjs",
    "api:reference": "node scripts/build-api-reference.mjs",
    "api:examples": "node scripts/update-api-examples.mjs",
    "postinstall": "wxt prepare",
    "fixtures": "node scripts/build-fixtures.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@mozilla/readability": "0.6.0",
    "idb": "8.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.3.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wxt": "0.21.5",
    "yaml": "^2.9.1"
  }
}
